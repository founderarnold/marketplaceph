# Copy to .env.development.local for local dev (values come from `npx supabase status -o env`).
# .env.local / .env.production.local hold your HOSTED project values for deploys. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Needed for account deletion and tests. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Phase 5
# Shared secret FLAME PH uses to call POST /api/flame/membership (24+ random characters). Server only.
FLAME_SYNC_SECRET=
# Trade Assurance (escrow) stays OFF until a licensed payment partner is integrated. See docs/TRADE_ASSURANCE.md.
TRADE_ASSURANCE_ENABLED=false

# Allow phone-OTP / Google login. Each button still shows only if that provider is enabled in Supabase
# (checked live, see lib/auth-providers.ts and README → Google sign-in), so "true" is safe before setup.
NEXT_PUBLIC_PHONE_LOGIN=true
NEXT_PUBLIC_GOOGLE_LOGIN=true

# Public, browser-safe FLAME Ads delivery endpoint. Use the preview API during QA.
NEXT_PUBLIC_FLAME_ADS_API_URL=https://api.ads.flameph.org
# Initial rollout is opt-in. Enable only in preview/staging until approved.
NEXT_PUBLIC_FLAME_ADS_ENABLED=false
